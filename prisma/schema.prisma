generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Score {
  id         Int      @id @default(autoincrement())
  playerName String
  mode       String
  score      Int
  accuracy   Int
  bestStreak Int
  correct    Int
  total      Int
  createdAt  DateTime @default(now())
}
